# Supabase (public anon key; used by the browser and server components)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase service role (server only; Spotify token storage)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Spotify app credentials (server only; search, top tracks, account connect)
SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET"

# Event source used by the sync script
EDMTRAIN_API_KEY="YOUR_EDMTRAIN_API_KEY"

# Canonical site URL: auth redirects, Spotify OAuth callback, share-card links
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"
